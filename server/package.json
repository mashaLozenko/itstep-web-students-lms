{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "description": "LMS Course Catalog API — Fastify + Prisma + SQLite backend",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node prisma/seed.js",
    "db:reset": "npx prisma migrate reset --force --skip-seed && npm run uploads:clean && npm run seed",
    "db:migrate": "npx prisma migrate dev",
    "db:generate": "npx prisma generate",
    "uploads:clean": "node -e \"const fs=require('fs');const p='uploads';if(fs.existsSync(p)){for(const f of fs.readdirSync(p))if(f!=='.gitkeep')fs.rmSync(p+'/'+f,{recursive:true,force:true})}\""
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/static": "^7.0.4",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.1.0",
    "@fastify/websocket": "^10.0.1",
    "@faker-js/faker": "^8.4.1",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "fastify-type-provider-zod": "^2.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
